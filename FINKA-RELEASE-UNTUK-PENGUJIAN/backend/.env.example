# Salin menjadi .env secara lokal; jangan commit atau kirim file .env.
# Tidak perlu server database; data tersimpan di file SQLite (DB_PATH).
PORT=3001
NODE_ENV=development
# Lokasi file database SQLite (dibuat otomatis). Default: ./data/finka.db
# Saat deploy, arahkan ke volume persisten, mis. /data/finka.db
DB_PATH=./data/finka.db

# Generate nilai acak panjang untuk masing-masing secret, jangan gunakan nilai sama.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
QR_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
PIN_OTP_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Isi hanya jika integrasi notifikasi benar-benar dikonfigurasi.
RESEND_API_KEY=
OTP_FROM_EMAIL=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=id
WHATSAPP_GRAPH_API_VERSION=v24.0

# Pisahkan daftar origin frontend dengan koma; sesuaikan dengan domain deploy.
CORS_ORIGINS=http://localhost:3000

# Detail rekening pembayaran dikonfigurasi melalui environment privat deployment.
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_ACCOUNT_HOLDER=
